  "narrative": {
    "northStar": "The Quilt Being Pieced",
    "overview": "Every region is a cotton patch sewn to the next with a visible dashed running stitch, on the app's warm cream backing. The eight pastels of the app own whole regions; the year grids are the print on the patches. Dark mode keeps the same cottons as deep dyed versions.\n\nThree surfaces share the system: printables (Persuade), the online tracker (Operate) and comparison pages (Read).",
    "keyCharacteristics": [
      "Whole-region cotton fields; blocks share straight edges and only outer corners round.",
      "The dashed stitch is the only seam device.",
      "One filled control per view; everything else outlined in ink.",
      "Flat except the paper sheet, the phone crop, the pin and the edit popover.",
      "Warm ink on every pastel in both themes; habit threads stay pastel in dark."
    ],
    "rules": [
      { "name": "The Cotton Owns the Region Rule", "body": "A pastel fills a whole patch or a swatch; it is never a text color, border or tint on a white card.", "section": "colors" },
      { "name": "The Warm Ink Rule", "body": "Text on every cotton, in both themes, is warm ink; no pure black, no pure white, no cool grey.", "section": "colors" },
      { "name": "The Never Red Rule", "body": "An empty square is the whole statement of a missed day; no red or warning color anywhere.", "section": "colors" },
      { "name": "The One Soft Face Rule", "body": "Caprasimo only at weight 400 and only for headings, numerals and the brand; labels, buttons and sentences stay in the system sans.", "section": "typography" },
      { "name": "The Stitch Is the Seam Rule", "body": "Division between regions is a dashed stitch or a change of cotton, never a solid box or a shadow.", "section": "elevation" }
    ],
    "dos": [
      "Do let a cotton own a whole region and put ink text on it.",
      "Do draw seams as dashed running stitch or change the cotton.",
      "Do keep empty squares readable in dark by mixing ink into them.",
      "Do keep tap targets at 44px or more and every color paired with a text label.",
      "Do keep year numerals and display headings in Caprasimo and everything else in the system sans.",
      "Do respect prefers-reduced-motion and prefers-color-scheme; keep state in the browser only."
    ],
    "donts": [
      "Don't use pure white or pure black for a page or a patch.",
      "Don't use red or any warning color for a missed day.",
      "Don't put kickers or eyebrows above headings; the build has none.",
      "Don't stack equal white cards in a row.",
      "Don't add shadows to buttons, patches, rows or squares.",
      "Don't load third-party scripts or webfonts other than the self-hosted Caprasimo subset."
    ]
  }
